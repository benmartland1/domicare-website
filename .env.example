# ---------------------------------------------------------------------------
# DomiCare (domicare.ai)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://domicare.ai

# Transactional email for the contact form and newsletter double opt-in.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
# INTERIM: domicare.ai is not verified in Resend and has no mailbox yet, so both
# point at the DomiSearch domain, which is verified. Swap to hi@domicare.ai and
# website@domicare.ai once Resend verifies the domain and a mailbox exists.
CONTACT_TO_EMAIL=hi@domisearch.com
CONTACT_FROM_EMAIL=website@domisearch.com

# Powers the internal, password-gated visibility tool at /visibility. All three
# are required together — the route 500s if either API key is missing, and the
# password gate rejects every request if VISIBILITY_PASSWORD is unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VISIBILITY_PASSWORD=

# Meta Pixel. Leave blank to disable tracking entirely.
NEXT_PUBLIC_META_PIXEL_ID=
