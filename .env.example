# ---------------------------------------------------------------------------
# DomiCare (domicare.ai)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://domicare.ai

# Transactional email for the contact form and newsletter double opt-in.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_TO_EMAIL=hi@domicare.ai
CONTACT_FROM_EMAIL=website@domicare.ai

# Powers the internal, password-gated visibility tool at /visibility. All three
# are required together — the route 500s if either API key is missing, and the
# password gate rejects every request if VISIBILITY_PASSWORD is unset.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VISIBILITY_PASSWORD=

# Meta Pixel. Leave blank to disable tracking entirely.
NEXT_PUBLIC_META_PIXEL_ID=
